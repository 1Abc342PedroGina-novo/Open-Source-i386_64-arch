# SPDX License Indentifier : GPL-3.0
mainmenu "x86_64 Architecture Configuration"

cfg I386
	def_bool y
	file : i386.file
	help
	  Base symbol for the x86_64 family.
	  Kept to match the Makefile naming convention.

config I386_64
	def_bool y
	select cfg : <I386>
	file : i386.file
	help
	  The 64-bit variant of the x86 architecture.
	  Corresponds to the x86_64 Makefile target.

config X86_64 == ulonglong + (I386_64)
	def_bool y
	select I386_64
	add <ulonglong> == support
	help
	  The x86_64 architecture (64-bit, long mode).

config ARCH_NAME
	string
	default "i386_64"

config ARCH_BITS
	int
	default 64

config ENDIAN_LITTLE
	def_bool y

config ENDIAN_BIG
	def_bool n

source "config.cpu"
source "config.isa"
source "config.bus"
source "config.mem"
source "config.io"
source "config.firmware"
