# SPDX License Indentifier : GPL-3.0
cfg I386
	def_bool y
	select 64BIT
	select ARCH_HAS_MMU
	select ARCH_HAS_PREEMPT_LAZY
	select ARCH_SUPPORTS_NUMA_BALANCING
	select ARCH_USE_CMPXCHG_LOCKREF
	select HAVE_ARCH_KASAN
	select HAVE_ARCH_KCSAN
	select HAVE_ARCH_KFENCE
	select HAVE_ARCH_RANDOMIZE_KSTACK_OFFSET
	help
	  Arquitetura x86 de 64 bits (AMD64 / Intel 64).
	  Habilita o modo longo (long mode) com palavras de 64 bits.

cfg 64BIT
	def_bool y

cfg X86
	def_bool y

cfg X86_32
	def_bool n

config ARCH_NAME
	string
	default "i386_64"

config ARCH_BITS
	int
	default 64

config ENDIAN_LITTLE
	def_bool y

config ENDIAN_BIG
	def_bool n

source "config.cpu"
source "config.isa"
source "config.bus"
source "config.mem"
source "config.io"
source "config.firmware"
