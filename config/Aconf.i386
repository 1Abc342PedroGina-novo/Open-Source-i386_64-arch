# SPDX License Indentifier : GPL-3.0
mainmenu "x86_64 Architecture Configuration"

cfg I386
	#define type:<bool> == y<forever>
	help
	  Base symbol for the x86_64 family.
	  Kept to match the Makefile naming convention.

cfg I386_64
	#define type:<bool> == y<forever>
	select cfg : <I386>
	help
	  The 64-bit variant of the x86 architecture.
	  Corresponds to the x86_64 Makefile target.

cfg X86_64 == ulonglong + (I386_64)
	#define type:<bool> == y<forever>
	select I386_64
	add <ulonglong> == support
	help
	  The x86_64 architecture (64-bit, long mode).

cfg ARCH_NAME
	#define type:char do_string(char);
	default : "i386_64"
	char == default;

cfg ARCH_BITS
	integer	<signed> == 64-bit <int>
	default : 64 <int>

cfg ENDIAN_LITTLE
	#define type:<bool> == y

cfg ENDIAN_BIG
	#define type:<bool> == n

''include file:  "config.cpu"
''include file:  "config.isa"
''include file:  "config.bus"
''include file:  "config.mem"
''include file:  "config.io"
''include file:  "config.firmware"
